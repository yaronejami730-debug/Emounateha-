{
  "outputDirectory": "public",
  "buildCommand": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 180,
      "includeFiles": "{supabase/migrations/**,crm-app/**,contenu/**}"
    }
  },
  "rewrites": [
    {
      "source": "/hebcal/:chemin*",
      "destination": "https://www.hebcal.com/:chemin*"
    },
    {
      "source": "/yt/:id/:fichier",
      "destination": "https://i.ytimg.com/vi/:id/:fichier"
    },
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "destination": "https://emounateha-don.vercel.app/.well-known/apple-developer-merchantid-domain-association"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__path=/api/$1"
    },
    {
      "source": "/u/(.*)",
      "destination": "/api/index.js?__path=/u/$1"
    },
    {
      "source": "/diffusion.json",
      "destination": "/api/index.js?__path=/diffusion.json"
    },
    {
      "source": "/diffusion/(.*)",
      "destination": "/api/index.js?__path=/diffusion/$1"
    },
    {
      "source": "/holidays.json",
      "destination": "/api/index.js?__path=/holidays.json"
    },
    {
      "source": "/login",
      "destination": "/api/index.js?__path=/login"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js?__path=/auth/$1"
    },
    {
      "source": "/invite/(.*)",
      "destination": "/api/index.js?__path=/invite/$1"
    },
    {
      "source": "/forgot",
      "destination": "/api/index.js?__path=/forgot"
    },
    {
      "source": "/crm",
      "destination": "/api/index.js?__path=/crm"
    },
    {
      "source": "/crm/(.*)",
      "destination": "/api/index.js?__path=/crm/$1"
    },
    {
      "source": "/diffusion-archives.json",
      "destination": "/api/index.js?__path=/diffusion-archives.json"
    }
  ],
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/don",
      "destination": "https://don.emounateha.fr/",
      "permanent": false
    },
    {
      "source": "/don/",
      "destination": "https://don.emounateha.fr/",
      "permanent": false
    },
    {
      "source": "/don/:path*",
      "destination": "https://don.emounateha.fr/",
      "permanent": false
    },
    {
      "source": "/don-cerfa",
      "destination": "https://don.emounateha.fr/",
      "permanent": true
    },
    {
      "source": "/don-cerfa/",
      "destination": "https://don.emounateha.fr/",
      "permanent": true
    },
    {
      "source": "/don-cerfa/:path*/",
      "destination": "https://don.emounateha.fr/:path*/",
      "permanent": true
    },
    {
      "source": "/don-cerfa/:path*",
      "destination": "https://don.emounateha.fr/:path*",
      "permanent": true
    }
  ]
}