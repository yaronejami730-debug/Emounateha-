{
  "outputDirectory": "public",
  "buildCommand": null,
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "supabase/migrations/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__path=/api/$1" },
    { "source": "/u/(.*)", "destination": "/api/index.js?__path=/u/$1" },
    { "source": "/diffusion.json", "destination": "/api/index.js?__path=/diffusion.json" },
    { "source": "/diffusion/(.*)", "destination": "/api/index.js?__path=/diffusion/$1" },
    { "source": "/holidays.json", "destination": "/api/index.js?__path=/holidays.json" }
  ]
}
